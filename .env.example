# Use Supabase to share reservations between all users.
# Copy this file to .env and add your Supabase project values.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# If your hosting or integration provides NEXT_PUBLIC_ variables instead, these are also supported:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Some setups also expose plain SUPABASE_ variables at build time:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# NOTE: Use only the base Supabase project URL.
# Do not include /rest/v1, /auth/v1, or any additional path segments.

# NOTE: Do not use a secret Service Role key in any browser-facing variable.
